generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  PARENT
}

enum TokenType {
  VERIFICATION
  RESET
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum MealType {
  BREAKFAST
  SNACK
  LUNCH
  AFTERNOON_SNACK
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum RequestType {
  LEAVE
  EARLY_PICKUP
  PROFILE_UPDATE
  DOCUMENT_REQUEST
  MEETING_REQUEST
}

enum PriorityLevel {
  NORMAL
  HIGH
  URGENT
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  passwordHash           String
  role                   Role
  isActive               Boolean   @default(true)
  isVerified             Boolean   @default(false)
  requiresPasswordChange Boolean   @default(false)
  locale                 String    @default("en")
  resetToken             String?   @unique
  resetTokenExpiresAt    DateTime?
  lastLogin              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Profile Fields
  name                   String?
  phone                  String?
  alternatePhone         String?
  nationalId             String?
  address                String?   @db.Text

  sessions               Session[]
  tokens                 Token[]
  logs                   AuditLog[]

  // Ownership Relations
  children       Child[]        @relation("ParentChildren")
  teacherClasses TeacherClass[]
  
  sentMessages           Message[] @relation("SentMessages")
  receivedMessages       Message[] @relation("ReceivedMessages")
  
  complaints             Complaint[]
  parentRequests         ParentRequest[]
  
  deviceTokens           DeviceToken[]
  notificationPrefs      NotificationPreference[]
  notifications          Notification[]
  
  streamSessions         StreamSession[]
  
  posts                  Post[]
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model Class {
  id       String         @id @default(uuid())
  name     String
  branchId String?
  capacity Int            @default(20)
  ageGroup String?
  teachers TeacherClass[]
  children Child[]
  cameras  Camera[]
}

model TeacherClass {
  teacherId String
  classId   String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([teacherId, classId])
}

model Child {
  id             String  @id @default(uuid())
  name           String
  parentId       String
  classId        String
  dob            DateTime?
  gender         String?
  medicalNotes   String? @db.Text
  enrollmentDate DateTime @default(now())

  parent         User    @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  class          Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  documents         Document[]
  complaints        Complaint[]
  emergencyContacts EmergencyContact[]
  authorizedPickups AuthorizedPickup[]
  
  attendanceRecords AttendanceRecord[]
  mealRecords       MealRecord[]
  activityRecords   ActivityRecord[]
  
  incidents         Incident[]
  weeklyNotes       WeeklyNote[]
  evaluations       Evaluation[]
  
  parentRequests    ParentRequest[]
}

model EmergencyContact {
  id       String @id @default(uuid())
  name     String
  phone    String
  relation String
  childId  String
  child    Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model AuthorizedPickup {
  id         String  @id @default(uuid())
  name       String
  phone      String
  photoUrl   String?
  nationalId String?
  childId    String
  child      Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
}

// Camera & Streaming
model Camera {
  id        String   @id @default(uuid())
  name      String
  streamUrl String
  isActive  Boolean  @default(true)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  
  schedules CameraSchedule[]
  sessions  StreamSession[]
}

model CameraSchedule {
  id        String   @id @default(uuid())
  cameraId  String
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, etc.
  startTime String   // e.g., "09:00"
  endTime   String   // e.g., "14:00"
  isActive  Boolean  @default(true)
  
  camera    Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
}

model StreamSession {
  id        String   @id @default(uuid())
  userId    String
  cameraId  String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  camera    Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
}

model Document {
  id      String @id @default(uuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Incident {
  id                String        @id @default(uuid())
  childId           String
  date              DateTime      @db.Date
  time              String
  severity          SeverityLevel
  description       String        @db.Text
  actionTaken       String?       @db.Text
  followUp          String?       @db.Text
  isVisibleToParent Boolean       @default(false)
  createdAt         DateTime      @default(now())
  
  child             Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Complaint {
  id          String        @id @default(uuid())
  title       String
  description String        @db.Text
  status      TicketStatus  @default(OPEN)
  parentId    String
  childId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  parent      User          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child       Child?        @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model ParentRequest {
  id          String        @id @default(uuid())
  parentId    String
  childId     String?
  type        RequestType
  description String        @db.Text
  status      TicketStatus  @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  parent      User          @relation(fields: [parentId], references: [id], onDelete: Cascade)
  child       Child?        @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Message {
  id          String    @id @default(uuid())
  senderId    String
  receiverId  String
  content     String    @db.Text
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  fcmToken   String   @unique
  deviceType String   // IOS, ANDROID, WEB
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id             String  @id @default(uuid())
  userId         String
  type           String  // ATTENDANCE, INCIDENT, MESSAGE, etc
  isEmailEnabled Boolean @default(true)
  isPushEnabled  Boolean @default(true)
  isInAppEnabled Boolean @default(true)

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, type])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  titleEn     String
  titleAr     String
  bodyEn      String
  bodyAr      String
  dataPayload String?  @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries  NotificationDelivery[]
}

model NotificationDelivery {
  id             String   @id @default(uuid())
  notificationId String
  deviceToken    String
  status         String   // PENDING, SUCCESS, FAILED
  errorReason    String?
  deliveredAt    DateTime?

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
}

model PostCategory {
  id          String   @id @default(uuid())
  nameEn      String
  nameAr      String
  slug        String   @unique
  posts       Post[]
}

model Post {
  id           String       @id @default(uuid())
  categoryId   String
  titleEn      String
  titleAr      String
  contentEn    String       @db.Text
  contentAr    String       @db.Text
  thumbnailUrl String?
  isPublished  Boolean      @default(false)
  orderIndex   Int          @default(0)
  authorId     String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  category     PostCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Event {
  id            String   @id @default(uuid())
  titleEn       String
  titleAr       String
  descriptionEn String   @db.Text
  descriptionAr String   @db.Text
  eventDate     DateTime
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Announcement {
  id          String         @id @default(uuid())
  titleEn     String
  titleAr     String
  contentEn   String         @db.Text
  contentAr   String         @db.Text
  priority    PriorityLevel  @default(NORMAL)
  isPublished Boolean        @default(false)
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model GalleryImage {
  id          String   @id @default(uuid())
  url         String
  captionEn   String?
  captionAr   String?
  isPublished Boolean  @default(false)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
}

model HomepageConfig {
  id          String   @id @default(uuid())
  section     String   @unique
  titleEn     String?
  titleAr     String?
  bodyEn      String?  @db.Text
  bodyAr      String?  @db.Text
  isVisible   Boolean  @default(true)
  orderIndex  Int      @default(0)
}

model WeeklyNote {
  id             String   @id @default(uuid())
  childId        String
  weekStartDate  DateTime @db.Date
  behavior       String?  @db.Text
  participation  String?  @db.Text
  socialSkills   String?  @db.Text
  communication  String?  @db.Text
  learning       String?  @db.Text
  activities     String?  @db.Text
  generalNotes   String?  @db.Text
  
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Evaluation {
  id             String   @id @default(uuid())
  childId        String
  term           String
  learning       Int      @default(3) // 1-5
  communication  Int      @default(3)
  socialSkills   Int      @default(3)
  participation  Int      @default(3)
  behavior       Int      @default(3)
  creativity     Int      @default(3)
  motorSkills    Int      @default(3)
  
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  deviceInfo String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  childId   String
  date      DateTime         @db.Date
  status    AttendanceStatus
  notes     String?
  child     Child            @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, date])
}

model MealRecord {
  id        String    @id @default(uuid())
  childId   String
  date      DateTime  @db.Date
  type      MealType
  notes     String?
  consumed  String?   // ALL, SOME, NONE
  child     Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model ActivityRecord {
  id          String    @id @default(uuid())
  childId     String
  date        DateTime  @db.Date
  title       String
  description String?   @db.Text
  child       Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
}

model Token {
  id        String    @id @default(uuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  details    String?  @db.Text
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
