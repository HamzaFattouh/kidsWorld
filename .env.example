# Production Environment Configuration Example
# Do not commit the actual .env file to version control.

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (MySQL 8)
DB_PASSWORD=your_secure_password
DATABASE_URL="mysql://root:${DB_PASSWORD}@database:3306/kidsworld"

# Caching / Rate Limiting (Redis)
REDIS_URL="redis://redis:6379"

# Security & Authentication
# Generate a strong 64-character hex string for production JWT secret
JWT_SECRET=generate_your_secure_jwt_secret_here
JWT_EXPIRES_IN=7d

# Firebase / Push Notifications
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourKeyHere\n-----END PRIVATE KEY-----\n"

# Media / Camera Server Configuration
CAMERA_MEDIA_SERVER_URL=https://media.kidsworld.example.com
CAMERA_SECRET_TOKEN=your_secure_camera_bridge_token

# Application URLs (For CORS, CSRF, and Emails)
WEB_APP_URL=https://app.kidsworld.example.com
API_BASE_URL=https://api.kidsworld.example.com
